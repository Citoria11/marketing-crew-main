{
  "name": "Marketing Crew",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  "features": {
    // Python for backend development
    "ghcr.io/devcontainers/features/python:1": { "version": "3.11" },
    // Node for frontend development
    "ghcr.io/devcontainers/features/node:1": { "version": "20" },
    // Docker CLI that talks to Docker Desktop on the Windows host
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.black-formatter",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "editor.formatOnSave": true,
        "[python]": { "editor.defaultFormatter": "ms-python.black-formatter" },
        "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
        "[typescriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" }
      }
    }
  },

  // Install deps so both Pylance and TypeScript language server work
  "postCreateCommand": "pip install -r backend/requirements.txt && cd frontend && npm install",

  // Forward the ports exposed by docker compose
  "forwardPorts": [4000, 8100, 8200, 5433],
  "portsAttributes": {
    "4000": { "label": "Frontend" },
    "8100": { "label": "Backend API" },
    "8200": { "label": "ChromaDB" },
    "5433": { "label": "PostgreSQL" }
  }
}
