# Copy this file to .env and fill in your values
# cp .env.example .env

# Required: OpenAI API key (used by all LLM and DALL-E 3 image generation)
OPENAI_API_KEY=sk-...

# Optional: Google Gemini API key (enables Veo 2 video generation)
# Get one at https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=AIzaSyCN9xESpHZ5gTwEnglb7OI_jSs4mGXXIGY

# Optional overrides (defaults shown)
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=marketing_crew
